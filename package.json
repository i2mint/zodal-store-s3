{
  "name": "@zodal/store-s3",
  "version": "0.2.0",
  "description": "zodal DataProvider adapter for AWS S3",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./presigned": {
      "types": "./dist/presigned.d.ts",
      "import": "./dist/presigned.js",
      "require": "./dist/presigned.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@zodal/core": "^0.2.0",
    "@zodal/store": "^0.2.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/s3-request-presigner": {
      "optional": true
    }
  },
  "devDependencies": {
    "@zodal/core": "^0.2.0",
    "@zodal/store": "^0.2.0",
    "@aws-sdk/client-s3": "^3.1085.0",
    "@aws-sdk/s3-request-presigner": "^3.1085.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/i2mint/zodal-store-s3.git"
  },
  "keywords": [
    "zodal",
    "dataprovider",
    "s3",
    "aws",
    "storage",
    "adapter"
  ],
  "packageManager": "pnpm@9.15.0"
}
